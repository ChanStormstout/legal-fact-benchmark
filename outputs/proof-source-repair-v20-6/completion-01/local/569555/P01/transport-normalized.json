      "evidence": [
        {
          "proposition": "The landlord accepted rent from the Association after the subletting, but the evidence does not establish he knew the appellant's possession was under a subtenancy rather than Association activities until May 1954.",
          "status": "DISSENTING_LEGAL_INTERPRETATION",
          "stage": "Sarkar J Dissenting Opinion",
          "court_level": "Supreme Court",
          "refs": [
            "SRC:241",
            "SRC:257",
            "SRC:258",
            "SRC:259",
            "SRC:260",
            "SRC:265",
            "SRC:266"
          ],
          "direction": "OPPOSE",
          "component_ids": [
            "R2.P2.K1"
          ],
          "application": "Sarkar J argues the landlord might have thought prior occupation was for the Association, and rent acceptance since 1954 is not mentioned as a fact establishing knowledge of subtenancy."
        },
        {
          "proposition": "The fact that a landlord had knowledge that a person other than a tenant was in possession did not by itself always lead to an inference that the landlord had knowledge that the person in possession was a sub-tenant.",
          "status": "SUPREME_COURT_ADOPTED_EVALUATION",
          "stage": "Supreme Court Majority Evaluation",
          "court_level": "Supreme Court",
          "refs": [
            "SRC:254",
            "SRC:255",
            "SRC:292"
          ],
          "direction": "SUPPORT",
          "component_ids": [
            "R2.P2.K1"
          ],
          "application": "Majority holds that knowledge of occupation does not equate to knowledge of subtenancy status."
        }
      ],
      "state": "FALSE",
      "stage": "Knowledge of Sustained Subtenancy",
      "basis": "When the landlord accepted rent from the Association after the subletting, he knew that the appellant's possession was under a subtenancy rather than occupation connected with the Association's activities.",
      "gaps": [
        "The record does not explicitly state that the landlord accepted rent from the Association *after* the subletting commenced in 1950, only that he received rent with full knowledge of the subletting according to the lower appellate court, which the Supreme Court majority found unsupported by evidence."
      ],
      "necessary_limits": []
