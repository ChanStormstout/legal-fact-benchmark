        "version_status": "INDIAN_KANOON_STATUTORY_REPRODUCTION_CURRENT_SNAPSHOT_HISTORICAL_VERSION_UNVERIFIED",
        "scope": "Delhi Rent Control Act section 16; read its own date/notice/consent conditions.",
