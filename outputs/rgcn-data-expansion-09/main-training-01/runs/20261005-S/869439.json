        "legal_status": "COURT_ADOPTED_SYNTHESIS",
        "coverage_limit": "Presumption is rebuttable. Different formulations in subparagraphs (i),(v),(vi) must be read together; do not apply consideration to every Delhi assignment/parting-with-possession alternative.",
        "dependencies": [],
        "source_status": "ADDRESSED_PASSAGE_RECOVERED_SOURCE_REVIEW_NOT_HUMAN_GOLD",
