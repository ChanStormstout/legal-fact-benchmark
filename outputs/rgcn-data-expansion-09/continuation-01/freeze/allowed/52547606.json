    {
      "id": "IK-52547606:L84",
      "source_document": "52547606",
      "original_line": 84,
      "text": "The ARCT had examined oral and documentary evidence and drew a conclusion that the tenant was Mohan Lal; he had parted with possession of the premises in favour of his son Anand Parkash who was carrying on business in the same premises; ground of subletting under cite10†Section 14 (1)(b) stood confirmed in favour of the landlord.",
      "provenance": [
        {
          "document_id": "52547606",
          "url": "https://indiankanoon.org/doc/52547606/",
          "response_index": 0,
          "raw_path": "outputs/rgcn-data-expansion-09/continuation-01/open-52547606-0.txt",
