  "proposal_relations": [
    {
      "from": "F1",
      "to": "F3",
      "sign": "SUPPORT",
      "refs": [
        "IK-789051:L67",
        "IK-789051:L106"
      ],
      "reason": "The Trial Court's finding of established possession supplies the factual starting point for the Supreme Court's reported settled-possession classification. Proof of possession alone is not sufficient to independently execute the OPEN_TEXT classification of settled possession."
    },
    {
      "from": "F3",
      "to": "F4",
      "sign": "OPPOSE",
      "refs": [
        "IK-789051:L92",
        "IK-789051:L94",
        "IK-789051:L105",
        "IK-789051:L106"
      ],
      "reason": "The target court's express characterization of the plaintiff's possession as settled opposes the complete proposition that it consisted merely of intermittent or incipient intrusion that had not matured into settled possession. This opposition does not independently resolve every underlying factual criterion or establish that no isolated intrusion ever occurred."
    },
    {
      "from": "F5",
      "to": "F1",
      "sign": "SUPPORT",
      "refs": [
        "IK-789051:L66",
        "IK-789051:L67"
      ],
      "reason": "The Supreme Court's account of construction being undertaken on land in the plaintiff's possession is consistent with the Trial Court's possession finding. It is contextual support within the reported judgment, not independent corroboration obtained from construction records or witnesses."
    },
    {
      "from": "F11",
      "to": "F10",
      "sign": "SUPPORT",
      "refs": [
        "IK-789051:L65",
        "IK-789051:L107",
        "IK-789051:L113"
      ],
      "reason": "The recorded uncertainty about adjoining parcel dimensions and boundaries helps explain why the courts could protect established possession without purporting to decide the competing proprietary claims. Boundary uncertainty is not itself proof of the express reservation; F10 is directly grounded in that reservation."
    },
    {
      "from": "F2",
      "to": "F10",
      "sign": "SUPPORT",
      "refs": [
        "IK-789051:L67",
        "IK-789051:L106",
        "IK-789051:L107",
        "IK-789051:L113"
      ],
      "reason": "The plaintiff's failure to prove title is consistent with, and helps explain the significance of, the separate judicial decision to leave ownership unresolved while adjudicating possession. It does not establish the falsity of the plaintiff's underlying ownership claim."
    },
    {
      "from": "F9",
      "to": "F10",
      "sign": "SUPPORT",
      "refs": [
        "IK-789051:L106",
        "IK-789051:L107",
        "IK-789051:L113"
      ],
      "reason": "The defendant's failure to establish title sufficient to justify eviction reinforces the need to distinguish present possessory protection from any later determination of superior proprietary rights. It does not establish that the defendant lacks title or preclude a future title action."
    }
  ],
