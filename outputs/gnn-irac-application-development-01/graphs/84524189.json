        }
      ]
    },
    {
      "id": "F2",
      "type": "Fact",
      "features": {
        "statement_status": "CLAIMED",
        "semantic_stage": "PRE_TARGET_RECORD",
        "party_side": "CLAIMANT",
        "court_level": "UNKNOWN",
        "polarity": "POSITIVE",
        "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET"
      },
      "source_grounded": true,
      "text": "It is alleged that none of those original partners is in actual or legal possession of the tenanted premises",
      "source_refs": [
        {
          "source_id": "IK-84524189:L91:span1",
          "quote": "none of the said partners is in actual possession or legal possession of the tenanted premises."
        }
      ]
    },
    {
      "id": "F4",
      "type": "Fact",
      "features": {
        "statement_status": "CLAIMED",
        "semantic_stage": "PRE_TARGET_RECORD",
        "party_side": "RESPONDENT",
        "court_level": "UNKNOWN",
        "polarity": "POSITIVE",
        "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET"
      },
      "source_grounded": true,
      "text": "Rajan Tiwari is stated to have been one of the partners at the commencement of the tenancy on 19.8.1991",
      "source_refs": [
        {
          "source_id": "IK-84524189:L97:span4",
          "quote": "Rajan Tiwari was one of the partners at the commencement of tenancy on 19.8.1991;"
        }
      ]
    },
    {
      "id": "I1",
      "type": "Issue",
      "features": {
        "statement_status": "CLAIMED",
        "semantic_stage": "PRE_TARGET_RECORD",
        "party_side": "CLAIMANT",
        "court_level": "UNKNOWN",
        "polarity": "UNKNOWN",
        "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET"
      },
      "source_grounded": true,
      "text": "Whether the changes in M/s Gill & Co's partnership and the alleged transfer of possession to new partners amounted to subletting, assignment, or parting with possession of the tenanted premises",
      "source_refs": [
        {
          "source_id": "IK-84524189:L104:span5",
          "quote": "at present, none of the partners, who were the partners of M/s Gill & Co at he time of inception of tenancy, are now the partners of the entity and the earlier partners have illegally sublet, assigned and parted with possession of the tenanted premises to some new partners"
        }
      ]
    }
