          "quote": "The witness proved the Forms A and B issued by the office of Registrar of Firms as Ex. RW1/F and RW1/G."
        }
      ]
    },
    {
      "id": "EV3",
      "type": "Evidence",
      "features": {
        "statement_status": "DOCUMENT_RECORDED",
        "semantic_stage": "PRE_TARGET_RECORD",
        "party_side": "NEUTRAL",
        "court_level": "UNKNOWN",
        "polarity": "UNKNOWN",
        "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET"
      },
      "source_grounded": true,
      "text": "Account opening form, undertaking, and letter of partnership dated 5.12.1991 and proved as Ex. RW1/B1 to B3",
      "source_refs": [
