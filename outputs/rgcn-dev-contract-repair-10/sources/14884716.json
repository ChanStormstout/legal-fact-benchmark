    {
      "id": "IK-14884716:L81",
      "source_document": "14884716",
      "original_line": 81,
      "text": "He states that CM APPL. 11364/2023 filed by the Petitioner for bringing on record the additional documents is without any merits. He states that the Petitioner did not file any written statement in the eviction proceedings.",
