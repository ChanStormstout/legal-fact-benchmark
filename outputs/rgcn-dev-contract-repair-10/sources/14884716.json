      "end": 483
    },
    {
      "id": "IK-14884716:L78",
      "source_document": "14884716",
      "original_line": 78,
      "text": " 3.2. He states that these documents were found just before the filing of the present petition and are relevant for evidencing the knowledge of the landlord, as regards, the sub-letting in favour of the Petitioner herein. He states that the sub-letting in the favour of Petitioner herein is in the year, 1944.",
      "provenance": [
        {
          "document_id": "14884716",
          "url": "https://indiankanoon.org/doc/14884716/",
          "response_index": 0,
          "raw_path": "outputs/rgcn-data-expansion-09/continuation-01/open-14884716-0.txt",
