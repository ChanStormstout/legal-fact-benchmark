    {
      "id": "IK-14884716:L92",
      "source_document": "14884716",
      "original_line": 92,
      "text": "The landlord has been unequivocally accepting the rent from the respondent without any demur and have never raised any objection with regard to the use of the premise by the aforesaid persons or any one of them. The petitioner is thus deemed to have waived his right, if any or at all to claim the user of the premises by the aforesaid persons amounts to an illegal sub- letting.",
      "provenance": [
        {
          "document_id": "14884716",
          "url": "https://indiankanoon.org/doc/14884716/",
          "response_index": 0,
          "raw_path": "outputs/rgcn-data-expansion-09/continuation-01/open-14884716-0.txt",
