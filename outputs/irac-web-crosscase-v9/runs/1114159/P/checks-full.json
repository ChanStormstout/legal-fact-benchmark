  "source_recovery": {
    "IK-1114159:L238:span1": {
      "text": "The respondent is the daughter of the original landlord who had let out the premises to the appellant on 1.10.1961.",
      "document_id": "1114159",
      "url": "https://indiankanoon.org/doc/1114159/",
      "semantic_stage": "PRE_TARGET_RECORD",
      "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET",
      "role": "CASE_RECORD"
    },
    "IK-1114159:L239:span2": {
      "text": "both the statutory authorities found that the premises which had been let out for residential purposes to the appellant had also been used incidentally for commercial purposes",
      "document_id": "1114159",
      "url": "https://indiankanoon.org/doc/1114159/",
      "semantic_stage": "PRIOR_COURT_FINDING",
      "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET",
      "role": "CASE_RECORD"
    },
    "IK-1114159:L240:span3": {
      "text": "This High Court found that there was no evidence for the statutory authorities to come to the conclusion, which they did, as regards the premises having been used for commercial purpose.",
      "document_id": "1114159",
      "url": "https://indiankanoon.org/doc/1114159/",
      "semantic_stage": "PRIOR_COURT_FINDING",
      "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET",
      "role": "CASE_RECORD"
    },
    "IK-1114159:L241:span4": {
      "text": "No documentary evidence has been brought on record to hold that the premises were ever used for boarding and lodging foreign students",
      "document_id": "1114159",
      "url": "https://indiankanoon.org/doc/1114159/",
      "semantic_stage": "PRIOR_COURT_FINDING",
      "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET",
      "role": "CASE_RECORD"
    },
    "IK-1114159:L244:span5": {
      "text": "The tenant contended that she had never parted with her exclusive possession of any part of the premises and the foreign students who were lodging were her paying guests and were not her tenants.",
      "document_id": "1114159",
      "url": "https://indiankanoon.org/doc/1114159/",
      "semantic_stage": "PRE_TARGET_RECORD",
      "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET",
      "role": "CASE_RECORD"
    },
    "IK-1114159:L238:restored-v2": {
      "text": "The respondent is the daughter of the original landlord who had let out the premises to the appellant on 1.10.1961. The present respondent purchased the property from her father on 27th June, 1964 and thus stepped into his shoes as the `landlord' as defined under cite13†section 2(e) of the Act.",
      "document_id": "1114159",
      "url": "https://indiankanoon.org/doc/1114159/",
      "semantic_stage": "PRE_TARGET_RECORD",
      "prospective_availability": "RETROSPECTIVELY_RECONSTRUCTED_PRE_TARGET",
      "parent_source_id": "IK-1114159:L238",
      "provenance": [
        {
          "document_id": "1114159",
          "url": "https://indiankanoon.org/doc/1114159/",
          "response_index": 0,
          "raw_path": "outputs/gnn-irac-native-data-01/sources/raw/single-1114159-0.txt",
          "raw_sha256": "d8af806cc2a8d2efb70c0ebd7f132dc0209d005eb86a4a19248e493c1688b9a5",
          "raw_char_range": [
