  "proposal_relations": [
    {
      "from": "F2",
      "to": "F5",
      "sign": "SUPPORT",
      "refs": [
        "IK-1841885:L62",
        "IK-1841885:L63",
        "IK-1841885:L68",
        "IK-1841885:L133"
      ],
      "reason": "The tenancy allegations and requested declaration in the identified plaint provide the pleaded context for the Supreme Court's characterization of the principal subject. This supports the characterization of the controversy, not the factual existence or validity of the asserted tenancy."
    },
    {
      "from": "F4",
      "to": "F5",
      "sign": "SUPPORT",
      "refs": [
        "IK-1841885:L68",
        "IK-1841885:L133"
      ],
      "reason": "The opposing asserted durations demonstrate why the tenancy period is materially disputed. Neither asserted duration supplies proof that the claimed term existed."
    },
    {
      "from": "F3",
      "to": "F5",
      "sign": "OPPOSE",
      "refs": [
        "IK-1841885:L70",
        "IK-1841885:L71",
        "IK-1841885:L133",
        "IK-1841885:L134",
        "IK-1841885:L136"
      ],
      "reason": "The trial court's assessment that no cause of action was disclosed and that a statutory bar required rejection stands in procedural opposition to the Supreme Court's identification of a separate civil-adjudicable tenancy controversy. This is opposition between legal assessments at different court levels, not conflicting proof of the underlying tenancy facts."
    },
    {
      "from": "F7",
      "to": "F8",
      "sign": "OPPOSE",
      "refs": [
        "IK-1841885:L62",
        "IK-1841885:L75",
        "IK-1841885:L138"
      ],
      "reason": "The plaintiffs alleged forcible eviction, whereas the respondent trust denied forcible eviction and asserted lawful possession-taking. Both remain attributed party positions."
    },
    {
      "from": "F7",
      "to": "F9",
      "sign": "SUPPORT",
      "refs": [
        "IK-1841885:L62",
        "IK-1841885:L79",
        "IK-1841885:L138"
      ],
      "reason": "The plaintiffs' allegation supplies the affirmative asserted account underlying the contested nonconsensual, unlawful dispossession proposition. It is assertion-level support only, not independent evidence establishing that proposition."
    },
    {
      "from": "F8",
      "to": "F9",
      "sign": "OPPOSE",
      "refs": [
        "IK-1841885:L75",
        "IK-1841885:L138"
      ],
      "reason": "The trust's contrary account opposes the allegation that the identified plaintiffs were dispossessed outside due process. The assertion of lawful taking does not independently establish consent, actual surrender or compliance with legal process."
    },
    {
      "from": "F12",
      "to": "F9",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1841885:L138",
        "IK-1841885:L152"
      ],
      "reason": "The alleged surrendering tenants are not identified. Their possible overlap with the plaintiffs is unresolved, so the group-level surrender submission cannot be transferred to the particular plaintiffs or treated as proof that the disputed dispossession was consensual."
    },
    {
      "from": "F14",
      "to": "F9",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1841885:L138",
        "IK-1841885:L151"
      ],
      "reason": "The Court identified the trial injunction's operative period as relevant to the possession dispute, but the necessary dates and their relationship to the alleged taking are absent. The timing observation leaves the full unlawful-dispossession proposition unresolved."
    },
    {
      "from": "F10",
      "to": "F9",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1841885:L139",
        "IK-1841885:L140",
        "IK-1841885:L141",
        "IK-1841885:L151"
      ],
      "reason": "The judgment distinguishes settled possession from fugitive possession but does not establish these plaintiffs' settled possession. That missing merits determination prevents use of the abstract possession-protection principle as proof that the complete disputed dispossession proposition occurred."
    },
    {
      "from": "F9",
      "to": "F11",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1841885:L138",
        "IK-1841885:L139",
        "IK-1841885:L144",
        "IK-1841885:L145",
        "IK-1841885:L150",
        "IK-1841885:L151"
      ],
      "reason": "The disputed possession event does not determine equitable entitlement to an injunction. Even potential restoration under Section 6 is analytically distinct from an injunction against a true owner; the necessary injunction-specific factual and discretionary assessment is uncompleted."
    },
    {
      "from": "F13",
      "to": "F11",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1841885:L74",
        "IK-1841885:L81",
        "IK-1841885:L145",
        "IK-1841885:L148",
        "IK-1841885:L152",
        "IK-1841885:L153"
      ],
      "reason": "Alleged failure to comply with deposit directions, arrears and litigation conduct could be raised where legally relevant, but they remain trust-side assertions. Without established facts and a discretionary merits assessment, they cannot establish or defeat injunction entitlement."
    }
  ],
