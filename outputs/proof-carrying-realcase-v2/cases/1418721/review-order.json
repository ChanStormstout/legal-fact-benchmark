  "proposal_relations": [
    {
      "from": "F4",
      "to": "F11",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L69",
        "IK-1418721:L70",
        "IK-1418721:L72",
        "IK-1418721:L85"
      ],
      "reason": "The reported trial-court findings of government acquisition, preservation, ownership and possession provide lower-court support consistent with the later affirmative Supreme Court title finding. They remain findings from a distinct procedural stage and do not independently execute the Supreme Court's evidentiary assessment."
    },
    {
      "from": "F6",
      "to": "F11",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L82",
        "IK-1418721:L83",
        "IK-1418721:L85"
      ],
      "reason": "The protected-monuments register's reported government ownership entry was an express component of the Supreme Court's combined title evaluation, subject to its narrow evidentiary treatment and the absence of independent exhibit authentication."
    },
    {
      "from": "F7",
      "to": "F6",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L82",
        "IK-1418721:L83"
      ],
      "reason": "The Supreme Court's characterization that the manner of acquisition was unchallenged supports its treatment of the register entry as acquisition-related evidence. It does not independently verify the historical acquisition or resolve the broader opposition to government ownership."
    },
    {
      "from": "F8",
      "to": "F11",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L83",
        "IK-1418721:L84",
        "IK-1418721:L85"
      ],
      "reason": "The reported CTS entries identifying the government respondent provide additional documentary support for the court's affirmative title evaluation, without independently or conclusively establishing title."
    },
    {
      "from": "F9",
      "to": "F11",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L84",
        "IK-1418721:L85"
      ],
      "reason": "The reported testimony concerning government possession, protected-monument status and construction expenditure formed part of the Supreme Court's conjoint evidentiary assessment. Testimony about possession is not automatically proof of ownership."
    },
    {
      "from": "F3",
      "to": "F11",
      "sign": "OPPOSE",
      "refs": [
        "IK-1418721:L65",
        "IK-1418721:L66",
        "IK-1418721:L67",
        "IK-1418721:L68",
        "IK-1418721:L78",
        "IK-1418721:L79",
        "IK-1418721:L80"
      ],
      "reason": "The Wakf parties advanced a competing historical and documentary ownership theory inconsistent with exclusive government title. This relation records substantive litigation opposition only; it does not elevate unproved assertions into established counter-title."
    },
    {
      "from": "F10",
      "to": "F3",
      "sign": "OPPOSE",
      "refs": [
        "IK-1418721:L80",
        "IK-1418721:L81"
      ],
      "reason": "The Supreme Court's finding of insufficient concrete evidence undermines the evidentiary substantiation of the Wakf parties' ownership claim. It does not prove their alleged historical events factually false."
    },
    {
      "from": "F5",
      "to": "F18",
      "sign": "OPPOSE",
      "refs": [
        "IK-1418721:L77",
        "IK-1418721:L89",
        "IK-1418721:L100",
        "IK-1418721:L101"
      ],
      "reason": "The High Court's additional acceptance of adverse possession stands in legal opposition to the Supreme Court's subsequent rejection of that basis. These are distinct judicial-stage determinations, not an unresolved identity or evidence conflict."
    },
    {
      "from": "F12",
      "to": "F18",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L92",
        "IK-1418721:L100"
      ],
      "reason": "The absence of specifically pleaded and proved exclusive possession and animus against the appellant is an expressly identified material deficiency supporting rejection of adverse possession, subject to contextual legal assessment."
    },
    {
      "from": "F13",
      "to": "F18",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L97",
        "IK-1418721:L100"
      ],
      "reason": "The missing specific pleading and proof of the appellant's earlier title undermines the asserted acquisition of another owner's title through adverse possession. The relation does not assert that an earlier title factually never existed."
    },
    {
      "from": "F14",
      "to": "F18",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L91",
        "IK-1418721:L93",
        "IK-1418721:L100"
      ],
      "reason": "The missing temporal foundation prevents the record from establishing the relevant commencement and duration of adverse possession. No dispossession date or statutory-period calculation is inferred."
    },
    {
      "from": "F15",
      "to": "F18",
      "sign": "SUPPORT",
      "refs": [
        "IK-1418721:L90",
        "IK-1418721:L91",
        "IK-1418721:L92",
        "IK-1418721:L93",
        "IK-1418721:L94",
        "IK-1418721:L100"
      ],
      "reason": "The Supreme Court's requirement of specifically pleaded and proved hostile possession supplies the legal significance of the recorded deficiencies. It does not turn the complete fact-sensitive adverse-possession inquiry into a checklist conjunction."
    },
    {
      "from": "F1",
      "to": "F2",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1418721:L59",
        "IK-1418721:L61",
        "IK-1418721:L89",
        "IK-1418721:L97"
      ],
      "reason": "The original-title assertion and alternative adverse-possession assertion concern the same government claimant and the collectively described disputed properties, raising the renunciation issue. Their simultaneous assertion does not independently establish whether a legally effective renunciation occurred."
    },
    {
      "from": "F16",
      "to": "F2",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1418721:L96",
        "IK-1418721:L97",
        "IK-1418721:L98",
        "IK-1418721:L99"
      ],
      "reason": "The reported precedent makes renunciation of the original-title basis legally relevant to the alternative adverse-possession theory. The legal standard alone does not determine whether renunciation was present, absent or effective in the particular proceedings."
    },
    {
      "from": "F17",
      "to": "F18",
      "sign": "UNRESOLVED",
      "refs": [
        "IK-1418721:L97",
        "IK-1418721:L100"
      ],
      "reason": "The record does not separately establish whether and when renunciation occurred. This unresolved question cannot be treated as an additional proven reason for rejecting adverse possession; the Supreme Court's identified pleading and proof deficiencies remain independently recorded."
    }
  ],
