{
  "request_hash": "ce01314990865608ed057edfc5ca4f16a26e9bff1fd080d4495589ae83d0b8d6",
  "raw_model_value": {
    "observations": [
      {
        "speaker_label": "CIVIL APPELLATE, JURISDICTION: Civil Appeal No. 73 of 1950",
        "content": "Appeal from Judgment and Decree dated 26th January, 1944, of High Court of Judicature at Patna, arising from Original Decree No. 4 of 1941, Court of Additional Subordinate Judge of Hazaribagh in Title Suit No. 45 of 1939.",
        "participants": [
          {
            "name_or_role": "S. N. Mukherjee",
            "role": "Appellant's Counsel"
          },
          {
            "name_or_role": "Gangacharan Mukherjee and A. N. Sinha",
            "role": "Respondents' Counsel"
          }
        ],
        "event": "Case jurisdiction and procedural history defined",
        "time": "1952",
        "procedure_and_court": "Civil Appeal No. 73 of 1950, High Court of Judicature at Patna",
        "witnesses": [
          {
            "span_id": "W0e966b296d7f"
          },
          {
            "span_id": "Wf1bfd68255e8"
          },
          {
            "span_id": "Wc6d2d7bb11b1"
          }
        ]
      },
      {
        "speaker_label": "BHAGWATI J",
        "content": "The question is whether prior to the enactment of section 65-A of the Transfer of Property Act in 1929, a mortgagor in possession had the power to grant a permanent lease of the mortgaged property so as to bind the mortgagee.",
        "participants": [
          {
            "name_or_role": "BHAGWATI J",
            "role": "Judge delivering judgment"
          }
        ],
        "event": "Legal question for consideration identified",
        "time": "October 23, 1952",
        "procedure_and_court": "High Court of Judicature at Patna",
        "witnesses": [
          {
            "span_id": "Wc6d2d7bb11b1"
          }
        ]
      },
      {
        "speaker_label": "Narrative of Facts",
        "content": "Raja Nilkanth Narain Singh mortgaged Gadi Sirampur to Chota Nagpur Banking Association Limited on 1st August, 1914. The Bank obtained a mortgage decree on 29th November, 1921, and purchased a third share on 28th October, 1922.",
        "participants": [
          {
            "name_or_role": "Raja Nilkanth Narain Singh",
            "role": "Original Owner/Mortgagor"
          },
          {
            "name_or_role": "Chota Nagpur Banking Association Limited",
            "role": "Mortgagee"
          },
          {
            "name_or_role": "Wazir Narain Singh",
            "role": "Son of Original Owner"
          }
        ],
        "event": "Mortgage and subsequent decree details",
        "time": "1914 to 1922",
        "procedure_and_court": "Original Mortgage Suit",
        "witnesses": [
          {
            "span_id": "Wcd7db9ab4cd0"
          }
        ]
      },
      {
        "speaker_label": "Narrative of Facts",
        "content": "During proceedings, on 5th November, 1925, Wazir Narain Singh granted a permanent lease of four villages to Hiraman Ram (Manager and Karta of joint Hindu family) and his son Chohan Ram.",
        "participants": [
          {
            "name_or_role": "Wazir Narain Singh",
            "role": "Mortgagor in possession"
          },
          {
            "name_or_role": "Hiraman Ram",
            "role": "Lessee/Manager"
          },
          {
            "name_or_role": "Chohan Ram",
            "role": "Lessee/Son"
          }
        ],
        "event": "Permanent lease granted during mortgage suit pendency",
        "time": "5th November, 1925",
        "procedure_and_court": "Court of Additional Subordinate Judge of Hazaribagh",
        "witnesses": [
          {
            "span_id": "W7780499143ec"
          }
        ]
      },
      {
        "speaker_label": "Narrative of Facts",
        "content": "An agreement was made that if Wazir Narain Singh paid Rs. 1,10,631-4-0 by 16th August, 1926, the sale would be set aside. He executed a mortgage on 14th August, 1926, to Court of Wards to satisfy dues and set aside the sale.",
        "participants": [
          {
            "name_or_role": "Wazir Narain Singh",
            "role": "Mortgagor"
          },
          {
            "name_or_role": "Court of Wards",
            "role": "New Mortgagee"
          },
          {
            "name_or_role": "Chota Nagpur Banking Association Limited",
            "role": "Original Mortgagee"
          }
        ],
        "event": "Sale set aside and new mortgage executed",
        "time": "1926",
        "procedure_and_court": "Execution proceedings",
        "witnesses": [
          {
            "span_id": "W527a5c1628be"
          }
        ]
      },
      {
        "speaker_label": "Narrative of Facts",
        "content": "Plaintiff (through Court of Wards) filed suit on 4th February, 1929 to enforce mortgage, impleading Hiraman Ram and Dilo Ram as defendants. Final decree for sale passed 18th September, 1931; Plaintiff purchased on 6th April, 1935.",
        "participants": [
          {
            "name_or_role": "Plaintiff (Court of Wards)",
            "role": "Auction Purchaser"
          },
          {
            "name_or_role": "Hiraman Ram",
            "role": "Defendant 20"
          },
          {
            "name_or_role": "Dilo Ram",
            "role": "Defendant 19"
          }
        ],
        "event": "Enforcement suit and auction sale",
        "time": "1929 to 1935",
        "procedure_and_court": "Suit for enforcement of mortgage",
        "witnesses": [
          {
            "span_id": "Wa7f505d303a6"
          },
          {
            "span_id": "W9b05c9b67dc1"
          }
        ]
      },
      {
        "speaker_label": "Narrative of Facts",
        "content": "Dilo Ram died after mortgage decree. Hiraman Ram and Chohan Ram continued possession. Plaintiff filed suit on 16th November, 1939 for khas possession against Hiraman Ram and Chohan Ram.",
        "participants": [
          {
            "name_or_role": "Plaintiff",
            "role": "Auction Purchaser"
          },
          {
            "name_or_role": "Hiraman Ram",
            "role": "Defendant 1"
          },
          {
            "name_or_role": "Chohan Ram",
            "role": "Defendant 2"
          }
        ],
        "event": "Suit for khas possession filed",
        "time": "16th November, 1939",
        "procedure_and_court": "Court of Additional Subordinate Judge of Hazaribagh",
        "witnesses": [
          {
            "span_id": "W8d517ce23ffb"
          }
        ]
      },
      {
        "speaker_label": "Defendant 2",
        "content": "Denied plaintiff was subrogated to Bank's position; argued decree not binding as he was not a party; Patta not ended by auction sale; alleged partition within a year after possession allotted properties to him.",
        "participants": [
          {
            "name_or_role": "Defendant 2",
            "role": "Hiraman Ram"
          },
          {
            "name_or_role": "Defendant 1",
            "role": "Chohan Ram"
          }
        ],
        "event": "Defendants contesting plaintiff's claim",
        "time": "During trial",
        "procedure_and_court": "Trial Court",
        "witnesses": [
          {
            "span_id": "W035a075d4185"
          },
          {
            "span_id": "Wf03ffd33c4a0"
          },
          {
            "span_id": "W6b27aaaae67f"
          }
        ]
      },
      {
        "speaker_label": "Trial Court",
        "content": "Held plaintiff subrogated to Bank's position; Defendant 1 was Manager/Karta; Defendant 2 fully represented; decree binding; plaintiff entitled to possession and mesne profits.",
        "participants": [
          {
            "name_or_role": "Trial Court",
            "role": "Court of Additional Subordinate Judge of Hazaribagh"
          }
        ],
        "event": "Trial Court judgment delivered",
        "time": "Prior to 1944",
        "procedure_and_court": "Trial Court",
        "witnesses": [
          {
            "span_id": "Wf5e3bcdd1e23"
          }
        ]
      },
      {
        "speaker_label": "High Court of Judicature at Patna",
        "content": "Negatived constructive res judicata contention. Considered if Wazir Narayan Singh had power to grant permanent lease. Concluded lease did not render Bank's security insufficient; held lease valid; dismissed plaintiff's suit.",
        "participants": [
          {
            "name_or_role": "High Court of Judicature at Patna",
            "role": "Appellate Court"
          }
        ],
        "event": "High Court judgment dismissing plaintiff's suit",
        "time": "26th January, 1944",
        "procedure_and_court": "High Court of Judicature at Patna",
        "witnesses": [
          {
            "span_id": "Wf1033376c481"
          },
          {
            "span_id": "W8c8523c9370a"
          },
          {
            "span_id": "W6298946c1e5a"
          }
        ]
      },
      {
        "speaker_label": "Plaintiff",
        "content": "Obtained leave to appeal to Privy Council from High Court decision; appeal admitted on 9th January, 1946.",
        "participants": [
          {
            "name_or_role": "Plaintiff",
            "role": "Appellant"
          }
        ],
        "event": "Appeal to Privy Council admitted",
        "time": "9th January, 1946",
        "procedure_and_court": "Privy Council",
        "witnesses": [
          {
            "span_id": "We805db367322"
          }
        ]
      },
      {
        "speaker_label": "Privy Council",
        "content": "Found plaintiff subrogated to Bank's position and Defendant 2 sufficiently represented; only surviving question is whether Wazir Narayan Singh had power to grant permanent lease to bind plaintiff.",
        "participants": [
          {
            "name_or_role": "Privy Council",
            "role": "Final Appellate Court"
          }
        ],
        "event": "Privy Council identifies sole legal question",
        "time": "1952",
        "procedure_and_court": "Privy Council",
        "witnesses": [
          {
            "span_id": "Wfe881295658e"
          }
        ]
      }
    ],
