    {
      "id": "IK-890045:L230",
      "source_document": "890045",
      "original_line": 230,
      "text": "> \"That whenever such an interpretation would be necessary in order to give the fullest scope and effect legally' possible to any covenant or contract herein contained, the expression \"The Lessor\" hereinbefore used shall include his heirs, executors, administrators and assigns. and the expression \"THE LESSEE\" hereinbefore used' shall include their representatives and assigns.\"",
      "provenance": [
