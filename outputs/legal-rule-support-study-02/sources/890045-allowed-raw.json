    {
      "id": "IK-890045:L260",
      "source_document": "890045",
      "original_line": 260,
      "text": "Bachawat, J. Originally one Amar Sarup owned the land and building at plot No. 5, Block 'M', Connaught Circus, New Delhi. By a lease dated March 1, 1956, Amar Sarup leased the property to Allen Berry & Co. (Calcutta) Ltd., (hereinafter referred to as the tenant) for a period of five years on a monthly rent of Rs. 297/-. Sometime thereafter, Amar Sarup transferred the property to the respondents. In or about May, 1959, the tenant assigned the tenancy rights.",
      "provenance": [
        {
          "document_id": "890045",
          "url": "https://indiankanoon.org/doc/890045/",
          "response_index": 0,
          "raw_path": "outputs/legal-rule-support-study-02/sources/raw/890045-window250.txt",
          "raw_sha256": "0338f3d96c9cc582f41b1572e16f475dc5f312d9bd50406b81ad3e5b5bc1f780",
