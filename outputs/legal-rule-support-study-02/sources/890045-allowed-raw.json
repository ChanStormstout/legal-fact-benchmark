          "response_index": 0,
          "raw_path": "outputs/legal-rule-support-study-02/sources/raw/890045-window0.txt",
          "raw_sha256": "4f0ebfbfed58ff4736619fce5f2f540c84e7057cfe308855400938c5037443a7",
