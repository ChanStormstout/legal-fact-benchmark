            8337
          ],
          "raw_physical_line": 159,
          "original_line": 163
        }
      ]
    },
    {
      "id": "IK-869439:L164",
      "source_document": "869439",
      "original_line": 164,
      "text": "> 1. The petition for eviction was not maintainable in the absence of a notice to quit while determining the tenancy,",
      "provenance": [
        {
          "document_id": "869439",
          "url": "https://indiankanoon.org/doc/869439/",
          "response_index": 0,
          "raw_path": "outputs/legal-rule-support-study-02/sources/raw/869439-window0.txt",
