        }
      ]
    },
    {
      "id": "IK-869439:L166",
      "source_document": "869439",
      "original_line": 166,
      "text": "> 2. There was no sub-letting or parting of possession by the appellant-tenant in favour of R.C. Abrol & Company Pvt. Ltd., and",
      "provenance": [
        {
          "document_id": "869439",
          "url": "https://indiankanoon.org/doc/869439/",
          "response_index": 0,
          "raw_path": "outputs/legal-rule-support-study-02/sources/raw/869439-window0.txt",
