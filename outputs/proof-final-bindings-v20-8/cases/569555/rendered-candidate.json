      ]
    }
  ],
  "counterarguments": [
    {
      "point": "The subletting occurred in November 1950, which is before the 1952 Act commencement, so the 1958 Act's ground for post-commencement subletting is inapplicable.",
      "refs": [
        "IK-569555:L100",
        "IK-569555:L211",
        "IK-569555:L276"
      ],
      "treatment": "REJECTED_AS_INAPPLICABLE",
