{
  "request_id": "Q1",
  "conclusion": "The Supreme Court majority held that the landlord is entitled to recover possession under section 13(1) proviso (c)(i) of the 1952 Act because the subletting occurred before the Act's commencement without consent, and the landlord did not acquiesce. The High Court's finding of acquiescence was set aside for lack of evidence. The 1958 Act does not apply to the merits of this pre-commencement subletting ground.",
  "grounds": [
    {
      "point": "The landlord relied on the statutory exception for pre-commencement unauthorized subletting under section 13(1) proviso (c)(i) of the 1952 Act.",
      "statement_status_and_stage": "UNDISPUTED_CASE_FACT",
      "case_refs": [
        "IK-569555:L206",
        "IK-569555:L208",
        "IK-569555:L209"
      ],
      "rule_refs": [
        "R1"
      ],
      "explanation": "The landlord claimed the tenant sublet the premises before June 9, 1952, without consent. This establishes the available statutory ground for eviction.",
      "claim_ids": [
        "C027",
        "C036",
        "C047"
      ],
      "actor_ids": [
        "569555/becf0e528e129e04/A01",
        "569555/becf0e528e129e04/A02",
        "569555/becf0e528e129e04/A03"
      ],
      "property_ids": [
        "569555/becf0e528e129e04/P01"
      ],
      "event_ids": [
        "569555/becf0e528e129e04/E01"
      ]
    },
    {
      "point": "The landlord knew of the appellant's physical occupation but this did not establish knowledge of subtenancy or acquiescence.",
      "statement_status_and_stage": "SUPREME_COURT_ADOPTED_EVALUATION",
      "case_refs": [
        "IK-569555:L292",
        "IK-569555:L294",
        "IK-569555:L295"
      ],
      "rule_refs": [
        "R2"
      ],
      "explanation": "The Court found that mere knowledge of occupation by a third party does not necessarily imply knowledge of a contractual subtenancy, especially given the appellant's prior role with the Association.",
      "claim_ids": [
        "C056",
        "C064",
        "C078"
      ],
      "actor_ids": [
        "569555/becf0e528e129e04/A01",
        "569555/becf0e528e129e04/A03"
      ],
      "property_ids": [
        "569555/becf0e528e129e04/P01"
      ],
      "event_ids": [
        "569555/becf0e528e129e04/E01"
      ]
    },
    {
      "point": "The High Court was competent to interfere in revision because the lower appellate finding of acquiescence was unsupported by any evidence.",
      "statement_status_and_stage": "SUPREME_COURT_ADOPTED_EVALUATION",
      "case_refs": [
        "IK-569555:L127",
        "IK-569555:L130",
        "IK-569555:L132"
      ],
      "rule_refs": [
        "R3"
      ],
      "explanation": "A finding arrived at without any evidence to support it means the court did not decide the case 'according to law' under section 35 of the 1952 Act.",
      "claim_ids": [
        "C077",
        "C078",
        "C091",
        "C092"
      ],
      "actor_ids": [
        "569555/becf0e528e129e04/A05",
        "569555/becf0e528e129e04/A06",
        "569555/becf0e528e129e04/A07"
      ],
      "property_ids": [
        "569555/becf0e528e129e04/P01"
      ],
      "event_ids": [
        "569555/becf0e528e129e04/E03",
        "569555/becf0e528e129e04/E04",
        "569555/becf0e528e129e04/E05"
      ]
    },
    {
      "point": "The 1958 Act does not govern the merits of the eviction ground because applying it would create new rights and liabilities contrary to the saving clause.",
      "statement_status_and_stage": "MAJORITY_LEGAL_INTERPRETATION",
      "case_refs": [
        "IK-569555:L224",
        "IK-569555:L246",
        "IK-569555:L251",
        "IK-569555:L263"
      ],
      "rule_refs": [
        "R5"
      ],
      "explanation": "The proviso to section 57(2) requires regard to the 1958 Act only where it clarifies or slightly modifies the old Act; it does not allow entirely new rights (like the 1958 subletting ground) to override the saved 1952 ground.",
      "claim_ids": [
        "C126",
        "C137",
        "C146",
        "C150"
      ],
      "actor_ids": [
        "569555/becf0e528e129e04/A07"
      ],
      "property_ids": [
        "569555/becf0e528e129e04/P01"
      ],
      "event_ids": [
