{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "conditions",
    "bindings",
    "element_targets",
    "issue_target",
    "gaps",
    "chain_status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_id",
          "exact_rule_quote",
          "description",
          "logical_role",
          "scope",
          "dependencies",
          "law_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "exact_rule_quote": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "logical_role": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "condition_id",
                "operator"
              ],
              "properties": {
                "condition_id": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "enum": [
                    "AND",
                    "OR",
                    "QUALIFICATION"
                  ]
                }
              }
            }
          },
          "law_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "maxItems": 6
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fact_id",
          "condition_id",
          "relation",
          "statement_status",
          "court",
          "stage",
          "case_refs",
          "reason",
          "input_candidate",
          "target_only"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "SUPPORTS",
              "DEFEATS",
              "RELEVANT_TO"
            ]
          },
          "statement_status": {
            "type": "string",
            "minLength": 1
          },
          "court": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "case_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "input_candidate": {
            "const": true
          },
          "target_only": {
            "const": false
          }
        }
      },
      "maxItems": 12
    },
    "element_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "status",
          "basis_kind",
          "target_refs",
          "reason"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SATISFIED",
              "DEFEATED",
              "UNRESOLVED"
            ]
          },
          "basis_kind": {
            "enum": [
              "FACT_ACCEPTED",
              "FACT_FALSE",
              "BURDEN_NOT_CARRIED",
              "NOT_DECIDED",
              "INSUFFICIENT_RECORD",
              "LEGAL_INTERPRETATION",
              "AMBIGUOUS_REASONING"
            ]
          },
          "target_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "quote"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issue_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "target_refs",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "NOT_SUPPORTED",
            "UNRESOLVED"
          ]
        },
        "target_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "quote"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "description",
          "affected_ids"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "chain_status": {
      "enum": [
        "PROPOSED_COMPLETE",
        "GAP"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
