  "display": {
    "case_id": "1114159",
    "target_stage": "Supreme Court civil appeal (Civil Appeal No. 1993 of 1982) from the Delhi High Court judgment in S.A.O. No. 59 of 1979.",
    "target_court": "Supreme Court of India",
    "records": [
      {
        "source_id": "IK-1114159:L238:restored-v2",
        "aliases": {
          "IK-1114159:L238:span1": [
            0,
            115
          ]
        },
        "document_id": "1114159",
        "stage": "PRE_TARGET_RECORD",
        "text": "The respondent is the daughter of the original landlord who had let out the premises to the appellant on 1.10.1961. The present respondent purchased the property from her father on 27th June, 1964 and thus stepped into his shoes as the `landlord' as defined under cite13†section 2(e) of the Act."
      },
      {
        "source_id": "IK-1114159:L239:restored-v2",
        "aliases": {
          "IK-1114159:L239:span2": [
            260,
            435
          ]
        },
        "document_id": "1114159",
        "stage": "PRIOR_COURT_FINDING",
        "text": "Relying upon the Rent Note and the appellant's letters dated 7.10.1961 and 18.8.1962 addressed to the respondent's father and the earlier proceedings between them for eviction of the appellant on the ground of sub-letting the premises for commercial purposes, both the statutory authorities found that the premises which had been let out for residential purposes to the appellant had also been used incidentally for commercial purposes so as to exclude the application of cite12†section 14 (1) (e) read with the Explanation thereto."
      },
      {
        "source_id": "IK-1114159:L240:span3",
        "aliases": {},
        "document_id": "1114159",
        "stage": "PRIOR_COURT_FINDING",
        "text": "This High Court found that there was no evidence for the statutory authorities to come to the conclusion, which they did, as regards the premises having been used for commercial purpose."
      },
      {
        "source_id": "IK-1114159:L241:span4",
        "aliases": {},
        "document_id": "1114159",
        "stage": "PRIOR_COURT_FINDING",
        "text": "No documentary evidence has been brought on record to hold that the premises were ever used for boarding and lodging foreign students"
      },
      {
        "source_id": "IK-1114159:L244:restored-v2",
        "aliases": {
          "IK-1114159:L244:span5": [
            0,
            195
          ]
        },
        "document_id": "1114159",
        "stage": "PRE_TARGET_RECORD",
        "text": "The tenant contended that she had never parted with her exclusive possession of any part of the premises and the foreign students who were lodging were her paying guests and were not her tenants. The plea of sub-tenancy raised by the landlord was thus rejected on the ground that those who logged with her were not sub-tenants but only paying guests."
      }
    ]
  },
