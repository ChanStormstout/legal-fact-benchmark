    },
    "ADDR-004": {
      "test_id": "DRC_SUBLETTING_C04",
      "branch_id": "",
      "test_text": "For parting with possession, possession is vested by the tenant in another person by divesting the tenant of physical possession and the right to possession; divestment or abandonment of the right to possession is required.",
      "branch_text": ""
