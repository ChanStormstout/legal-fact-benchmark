{
  "role": "MODEL_ASSISTED_SOURCE_REVIEW_NOT_HUMAN_GOLD",
  "review_passes": 1,
  "reviewer": "Main session source comparison; no additional reviewer agent",
  "extra_web_review_calls_planned": 0,
  "axes": [
    "speaker/proposition/court-stage fidelity",
    "material opposing reasons not merely more points",
    "rule premises scope and real gaps",
    "new unsupported claims contradictions or omissions"
  ],
  "categories": [
    "NET_IMPROVEMENT",
    "CLOSE_OR_MIXED",
    "WORSE",
    "NOT_COMPARABLE"
  ],
  "separate_source_gaps_from_use_failure": true,
  "outcome_label_not_accuracy": true,
  "do_not_require_historical_outcome": true,
  "do_not_force_unknown_when_prior_findings_support_condition": true,
  "neutral_labels_before_review": true,
  "not_fully_blind": "instruction style may expose treatment",
  "fixed_existing_anchors": "evaluation/existing-error-anchors.json",
  "do_not_transmit_anchors_to_tested_model": true,
  "new_errors_recorded_without_repairs": true,
  "failed_answer_null_not_UNKNOWN": true,
  "no_six_case_accuracy_rank": true
}
