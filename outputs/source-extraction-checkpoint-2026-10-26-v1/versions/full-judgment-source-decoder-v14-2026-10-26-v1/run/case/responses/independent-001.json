            }
          },
          "proposition": {
            "text": "One Raja Nilkanth Narain Singh was the owner of Gadi Sirampur and he executed the 1st August, 1914, a simple mortgage of Gadi Sirampur in favour of the Chota Nagpur Banking Association Limited. In 1920 the Bank filed a suit against his son Wazir Narain Singh to enforce the mortgage security and obtained a mortgage decree the 29th November, 1921. The Bank purchased a third share of Gadi Sirampur in execution of that decree the 28th October, 1922. Proceedings were taken to set aside this sale.",
            "polarity": "POSITIVE",
            "negation_scope": null
