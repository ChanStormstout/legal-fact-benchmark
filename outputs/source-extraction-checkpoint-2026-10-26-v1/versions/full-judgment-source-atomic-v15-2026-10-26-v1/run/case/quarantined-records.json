        }
      },
      "proposition": {
        "assertion_type": "OBLIGATION",
        "text": "The true position is somewhere in the middle of these two extremes. The mortgagee is not normally bound by the acts of the mortgagor with reference to the mortgaged property. But if a mortgagee takes his security with knowledge of the purposes to which the land is applied and allows the mortgagor to remain in possession he will be bound by the acts done by the mortgagor in accordance with the usual course.",
        "polarity": "MIXED",
        "negation_scope": null
