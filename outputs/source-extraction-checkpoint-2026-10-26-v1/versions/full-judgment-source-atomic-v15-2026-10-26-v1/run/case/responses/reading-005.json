              "value": null,
              "source_ids": []
            },
            "statement_time": {
              "value": "1952",
              "source_ids": [
                "IKWEB-1251841:L55"
              ]
            },
            "proceeding": {
              "value": "Raja Kamakshyanarayan Singh Bahadur vs Chohan Ram And Another",
              "source_ids": [
                "IKWEB-1251841:L39"
              ]
            }
          },
          "qualifications": [],
          "uncertainties": []
        }
      ],
      "note": "Extraction of the observation by Lord Selborne regarding the precarious title of a lessee from a mortgagor without mortgagee concurrence.",
      "missing_relationships": []
    },
