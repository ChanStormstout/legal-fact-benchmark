          },
          "proposition": {
            "assertion_type": "OBLIGATION",
            "text": "If a mortgagor left in possession, grants a lease without the concurrence of the mortgagee, the lessee has a precarious title, inasmuch as although the lease is good as between himself and the mortgagor who granted it, the paramount title of the mortgagee may be asserted against both of them.",
            "polarity": "POSITIVE",
            "negation_scope": null
          },
          "participants": [],
          "scope": {
            "property": {
              "value": "mortgaged property",
              "source_ids": [
