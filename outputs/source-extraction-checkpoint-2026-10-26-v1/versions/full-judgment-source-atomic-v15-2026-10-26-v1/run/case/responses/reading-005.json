            }
          },
          "proposition": {
            "assertion_type": "OBLIGATION",
            "text": "Though a mortgagor may assign the mortgaged premises, the assignee can only take subject to the encumbrances, and if the property is sold or foreclosed by the mortgagee, any interest which the mortgagor may have created since the mortgage will be destroyed.",
            "polarity": "POSITIVE",
            "negation_scope": null
          },
          "participants": [],
          "scope": {
            "property": {
              "value": "mortgaged premises",
              "source_ids": [
