              ]
            },
            "event_time": {
              "value": null,
              "source_ids": []
            },
            "statement_time": {
              "value": "1952",
              "source_ids": [
                "IKWEB-1251841:L55"
              ]
            },
            "proceeding": {
              "value": "Raja Kamakshyanarayan Singh Bahadur vs Chohan Ram And Another",
              "source_ids": [
                "IKWEB-1251841:L39"
              ]
            }
          },
          "qualifications": [],
          "uncertainties": []
        }
      ],
      "note": "Extraction of the balanced position regarding mortgagee binding by mortgagor's acts in usual course.",
      "missing_relationships": []
    },
