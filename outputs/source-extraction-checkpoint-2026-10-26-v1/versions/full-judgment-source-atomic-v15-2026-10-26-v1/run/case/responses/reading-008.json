            "IKWEB-1251841:L173"
          ],
          "content_kind": "LEGAL_PROPOSITION",
          "statement_mode": "FINDING",
          "attribution": {
            "speaker": {
              "value": "Supreme Court of India",
              "source_ids": [
                "IKWEB-1251841:L37"
              ]
            },
            "forum": {
              "value": "Supreme Court of India",
              "source_ids": [
                "IKWEB-1251841:L37"
              ]
            },
            "case_context": "CURRENT_CASE",
            "case_reference": {
              "value": "Raja Kamakshyanarayan Singh Bahadur vs Chohan Ram And Another",
              "source_ids": [
                "IKWEB-1251841:L39"
              ]
            }
          },
          "proposition": {
            "assertion_type": "OBLIGATION",
            "text": "The mortgagor in possession may make a lease conformable to usage in the ordinary course of management.",
            "polarity": "POSITIVE",
            "negation_scope": null
          },
          "participants": [],
          "scope": {
            "property": {
              "value": "mortgaged property",
              "source_ids": [
                "IKWEB-1251841:L173"
              ]
            },
            "event_time": {
              "value": null,
              "source_ids": []
            },
            "statement_time": {
              "value": "23 October, 1952",
              "source_ids": [
                "IKWEB-1251841:L39"
              ]
            },
            "proceeding": {
              "value": "Raja Kamakshyanarayan Singh Bahadur vs Chohan Ram And Another",
              "source_ids": [
                "IKWEB-1251841:L39"
              ]
            }
          },
          "qualifications": [
            {
              "type": "EXAMPLE",
              "content": {
                "value": "he may create a tenancy from year to year in the case of agricultural lands or from month to month in the case of houses.",
                "source_ids": [
                  "IKWEB-1251841:L173"
                ]
              }
            },
            {
              "type": "LIMITATION",
              "content": {
                "value": "it is not competent to him to grant a lease unusual terms or to alter the character of the land or to authorise its use in a manner, or for a purpose, different from the mode in which he himself had used it before he granted the mortgage.",
                "source_ids": [
                  "IKWEB-1251841:L173"
                ]
              }
            },
            {
              "type": "BURDEN",
              "content": {
                "value": "it is for the lessee, if he wants to resist the claim of the mortgagee, to establish that the lease in his favour was granted the usual terms in the ordinary course of management.",
                "source_ids": [
                  "IKWEB-1251841:L173"
                ]
              }
            }
          ],
          "uncertainties": []
        }
      ],
      "note": "The court states the general principle regarding the mortgagor's power to lease in the ordinary course of management.",
      "missing_relationships": []
    },
