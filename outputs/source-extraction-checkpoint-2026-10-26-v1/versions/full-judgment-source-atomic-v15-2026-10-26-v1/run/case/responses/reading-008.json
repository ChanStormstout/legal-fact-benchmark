              ]
            }
          },
          "proposition": {
            "assertion_type": "FACT",
            "text": "Section 66 of the Transfer of Property Act has nothing to do with the mortgagor's power to lease the mortgaged property.",
            "polarity": "NEGATIVE",
            "negation_scope": "Section 66... has nothing to do with the mortgagor's power to lease"
          },
          "participants": [],
          "scope": {
            "property": {
              "value": "mortgaged property",
              "source_ids": [
                "IKWEB-1251841:L181"
              ]
            },
            "event_time": {
              "value": null,
              "source_ids": []
            },
            "statement_time": {
              "value": "23 October, 1952",
              "source_ids": [
                "IKWEB-1251841:L39"
              ]
            },
            "proceeding": {
              "value": "Raja Kamakshyanarayan Singh Bahadur vs Chohan Ram And Another",
              "source_ids": [
                "IKWEB-1251841:L39"
              ]
            }
          },
          "qualifications": [
            {
              "type": "EXCEPTION",
              "content": {
                "value": "Section 66 is a statutory enactment of the powers of the mortgagor in possession in regard to waste of mortgaged property.",
                "source_ids": [
                  "IKWEB-1251841:L181"
                ]
              }
            },
            {
              "type": "LIMITATION",
              "content": {
                "value": "The mortgagor in possession is not liable for permissive waste (omission to repair or prevent natural deterioration).",
                "source_ids": [
                  "IKWEB-1251841:L181"
                ]
              }
            },
            {
              "type": "LIMITATION",
              "content": {
                "value": "The mortgagor is liable for destructive waste (acts which are destructive or permanently injurious to the mortgaged property if the security was insufficient or would be rendered insufficient by such acts).",
                "source_ids": [
                  "IKWEB-1251841:L181"
                ]
              }
            }
          ],
          "uncertainties": []
        }
      ],
      "note": "The court clarifies the scope of Section 66, distinguishing it from the power to lease.",
