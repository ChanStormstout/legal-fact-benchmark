              ]
            },
            "proceeding": {
              "value": "Civil Appeal No. 73 of 1950",
              "source_ids": [
                "IKWEB-1251841:L120"
              ]
            }
          },
          "qualifications": [
            {
              "type": "OTHER",
              "content": {
                "value": "Hiraman Ram was the Manager and Karta of his joint Hindu family. The Permanent lease was taken by him in his own name and in the name of his son Chohan Ram.",
