                "value": "Hiraman Ram",
                "source_ids": [
                  "IKWEB-1251841:L123"
                ]
              }
            }
          ],
          "scope": {
            "property": {
              "value": "four villages Nawadih, Koldih, Pandna and Chihutia",
              "source_ids": [
