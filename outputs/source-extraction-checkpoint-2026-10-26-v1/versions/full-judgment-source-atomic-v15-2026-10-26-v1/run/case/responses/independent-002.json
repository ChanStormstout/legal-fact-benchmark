                ]
              },
              "referent": {
                "value": "Wazir Narain Singh",
                "source_ids": [
                  "IKWEB-1251841:L123"
                ]
              }
            }
          ],
          "scope": {
            "property": {
              "value": "sale of Gadi Sirampur",
              "source_ids": [
                "IKWEB-1251841:L124"
              ]
            },
            "event_time": {
              "value": "before the 16th August, 1926",
              "source_ids": [
